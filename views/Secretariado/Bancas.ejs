<%
const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'Secretariado';
%>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bancas Agendadas</title>
    <link rel="stylesheet" href="/cssSecretaria/Bancas.css">
    <link rel="stylesheet" href="/cssSecretaria/BottomSheet.css">
    <script>
        (function() {
            const tema = localStorage.getItem("tema_app") || "sistema";
            if (
                tema === "escuro" ||
                (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>
<div id="TelaBancas" class="container-tela">

    <header id="Header">
        <button type="button" class="icon-btn" id="btnConfig" aria-label="Configurações">
            <span class="icon-mask icon-settings"></span>
        </button>

        <h1 id="TituloPagina">Bancas</h1>

        <a href="/notificacoes?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Notificações">
            <span class="icon-mask icon-notification"></span>
        </a>
    </header>

    <main id="CorpoScroll">

        <div class="wrapper-busca">
            <div class="input-busca-container">
                <span class="icon-mask icon-search"></span>
                <input 
                    type="text" 
                    id="inputBusca" 
                    placeholder="Buscar banca por aluno, título ou data..." 
                >
            </div>
            
            <button type="button" class="btn-filtro" id="btnAbrirFiltro" aria-label="Filtrar">
                <span class="icon-mask icon-filter"></span>
            </button>
        </div>

        <!-- Painel de Filtros (oculto por padrão via inline style) -->
        <div id="painelFiltros" class="painel-filtros-inatos" style="display: none; margin-top: 12px; margin-bottom: 12px;">
            <div class="campo-filtro">
                <div class="select-container">
                    <select id="filtroLocal" class="select-filtro">
                        <option value="">Todos os Locais</option>
                        <option value="Auditório">Auditório</option>
                        <option value="Sala 01">Sala 01</option>
                        <option value="Virtual">Virtual</option>
                    </select>
                    <span class="icon-mask icon-seta-baixo select-icone"></span>
                </div>
            </div>

            <div class="campo-filtro">
                <div class="select-container">
                    <select id="filtroLinha" class="select-filtro">
                        <option value="">Todas as Linhas</option>
                        <option value="Computação">Computação</option>
                        <option value="Agronomia e Solos">Agronomia e Solos</option>
                        <option value="Química Orgânica e Analítica">Química Orgânica e Analítica</option>
                        <option value="Educação e Didática">Educação e Didática</option>
                        <option value="Gestão e Finanças">Gestão e Finanças</option>
                    </select>
                    <span class="icon-mask icon-seta-baixo select-icone"></span>
                </div>
            </div>

            <div class="campo-filtro">
                <div class="select-container">
                    <select id="filtroCurso" class="select-filtro">
                        <option value="">Todos os Cursos</option>
                        <option value="Licenciatura em Ciências da Computação">Licenciatura em Ciências da Computação</option>
                        <option value="Licenciatura em Ciências Agrárias">Licenciatura em Ciências Agrárias</option>
                        <option value="Licenciatura em Química">Licenciatura em Química</option>
                        <option value="Bacharel em Adiministração">Bacharel em Adiministração</option>
                    </select>
                    <span class="icon-mask icon-seta-baixo select-icone"></span>
                </div>
            </div>

            <div class="campo-filtro">
                <div class="select-container">
                    <select id="filtroDefesa" class="select-filtro">
                        <option value="">Todas as Defesas</option>
                        <option value="TCC I">TCC I</option>
                        <option value="TCC II">TCC II</option>
                    </select>
                    <span class="icon-mask icon-seta-baixo select-icone"></span>
                </div>
            </div>
        </div>

        <div id="painelOrdenacao" class="painel-filtros-inatos" style="display: none; margin-top: 12px; margin-bottom: 12px;">
            <div class="campo-filtro">
                <div class="select-container select-ordenacao">
                    <select id="selectOrdenacao" class="select-filtro-ordem">
                        <option value="data-proxima">Data (Mais próximas)</option>
                        <option value="data-distante">Data (Mais distantes)</option>
                        <option value="nome-asc">Aluno (A-Z)</option>
                        <option value="nome-desc">Aluno (Z-A)</option>
                        <option value="titulo-asc">Título TCC (A-Z)</option>
                        <option value="titulo-desc">Título TCC (Z-A)</option>
                    </select>
                    <span class="icon-mask icon-seta-baixo select-icone"></span>
                </div>
            </div>
        </div>

        <div class="info-meta">
            <span id="totalBancas">Total: <%= bancas.length %> Bancas Agendadas</span>
            <span class="ordenar-text" id="btnAbrirOrdenacao" style="cursor: pointer; color: var(--purple, #a855f7); font-weight: 600;">
                Ordenar: Data (Mais próximas) ▾
            </span>
        </div>

        <div id="listaBancasContainer">
            <% bancas.forEach(banca => { %>
                <div class="grupo-data" 
                     data-aluno="<%= banca.alunoNome ? banca.alunoNome.toLowerCase() : '' %>" 
                     data-titulo="<%= banca.tccTitulo ? banca.tccTitulo.toLowerCase() : (banca.tituloTcc ? banca.tituloTcc.toLowerCase() : '') %>"
                     data-local="<%= banca.local || '' %>"
                     data-linha="<%= banca.linhaPesquisa || '' %>"
                     data-curso="<%= banca.curso || '' %>"
                     data-defesa="<%= banca.defesa || '' %>"
                     data-iso="<%= banca.dataIso || '' %>">

                    <span class="data-grupo-titulo"><%= banca.dataExtenso || banca.data %></span>

                    <a href="/bancas/<%= banca.id %>?perfil=<%= perfilAtual %>" class="card-banca">
                        <div class="banca-data-box">
                            <span class="dia"><%= banca.dataDia || '20' %></span>
                            <span class="mes"><%= banca.dataMes || 'AGO' %></span>
                            <span class="horario"><%= banca.horario %></span>
                        </div>

                        <div class="banca-detalhes">
                            <h2 class="aluno-nome"><%= banca.alunoNome %></h2>
                            <p class="tcc-titulo"><%= banca.tccTitulo || banca.tituloTcc %></p>
                            <span class="banca-local"><%= banca.local %></span>
                        </div>

                        <div class="banca-acao">
                            <span class="icon-mask icon-chevron-right"></span>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>

        <div id="mensagemVazia" style="display: none; text-align: center; padding: 40px 16px; color: var(--text-2);">
            <p style="font-weight: 700; margin-bottom: 4px; color: var(--text-1);">Nenhuma banca encontrada</p>
            <p style="font-size: 0.8rem;">Tente alterar os termos de busca ou filtros aplicados.</p>
        </div>

    </main>

    <a href="/agendar-banca?perfil=<%= perfilAtual %>" class="btn-fab" aria-label="Agendar nova banca">
        <span class="icon-mask icon-plus"></span>
    </a>

    <nav id="BottomNav">
        <a href="/dashboard?perfil=<%= perfilAtual %>" class="nav-item">
            <span class="icon-mask icon-home"></span>
            <span>Início</span>
        </a>

        <a href="/alunos?perfil=<%= perfilAtual %>" class="nav-item">
            <span class="icon-mask icon-studant"></span>
            <span>Alunos</span>
        </a>

        <a href="/professores?perfil=<%= perfilAtual %>" class="nav-item">
            <span class="icon-mask icon-professor"></span>
            <span>Professores</span>
        </a>

        <a href="/acervo?perfil=<%= perfilAtual %>" class="nav-item">
            <span class="icon-mask icon-acervo"></span>
            <span>Acervo</span>
        </a>

        <button id="btnAbrirMais" type="button" class="nav-item nav-btn">
            <span class="icon-mask icon-more"></span>
            <span>Mais</span>
        </button>
    </nav>

</div>

<script src="/js/BottomSheet.js"></script>
<script src="/js/BancasFiltros.js"></script>

</body>
</html>