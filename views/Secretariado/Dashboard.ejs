<%
    const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'Secretariado';
    const paginaAtual = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : 'inicio';
    const periodoSelecionado = (typeof periodo !== 'undefined' && periodo) ? periodo : '2026.1';

    const [anoStr, semestreStr] = periodoSelecionado.split('.');
    const anoPeriodo = parseInt(anoStr, 10);
    const semestrePeriodo = parseInt(semestreStr, 10);

    const isFechado = (anoPeriodo < 2026) || (anoPeriodo === 2026 && semestrePeriodo < 1);
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/cssSecretaria/Dashboard.css">
    <link rel="stylesheet" href="/cssSecretaria/BottomSheet.css">
    
    <script>
        (function() {
            const tema = localStorage.getItem("tema_app") || "sistema";
            if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>

    <div id="TelaDashboard">
        <header id="Header">
            <a href="/configuracoes?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Configurações">
                <span class="icon-mask icon-settings"></span>
            </a>
            <h1 id="TituloPagina">Dashboard</h1>
            <div class="header-actions">
                <a href="/notificacoes?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Notificações">
                    <span class="icon-mask icon-notification"></span>
                </a>
            </div>
        </header>

        <main id="CorpoScroll">
            <div class="saudacao-container">
                <h2>Olá, Secretaria! 👋</h2>
                <p>Aqui está o resumo geral do sistema</p>
            </div>

            <div class="card-resumo">
                <div class="resumo-topo">
                    <div class="resumo-titulo-container">
                        <span class="resumo-titulo">Resumo geral</span>
                        <span id="badgeStatusPeriodo" class="badge-status-periodo <%= isFechado ? '' : 'oculto' %>">Período letivo fechado</span>
                    </div>
                    <div class="select-periodo-wrapper">
                        <label for="periodoLetivo" class="sr-only">Período letivo</label>
                        <select id="periodoLetivo" class="select-periodo" onchange="atualizarEstadoInterface(this.value)">
                            <option value="2026.1" <%= periodoSelecionado === '2026.1' ? 'selected' : '' %>>Período letivo: 2026.1</option>
                            <option value="2025.2" <%= periodoSelecionado === '2025.2' ? 'selected' : '' %>>Período letivo: 2025.2</option>
                            <option value="2025.1" <%= periodoSelecionado === '2025.1' ? 'selected' : '' %>>Período letivo: 2025.1</option>
                            <option value="2024.2" <%= periodoSelecionado === '2024.2' ? 'selected' : '' %>>Período letivo: 2024.2</option>
                            <option value="2024.1" <%= periodoSelecionado === '2024.1' ? 'selected' : '' %>>Período letivo: 2024.1</option>
                            <option value="2023.2" <%= periodoSelecionado === '2023.2' ? 'selected' : '' %>>Período letivo: 2023.2</option>
                            <option value="2023.1" <%= periodoSelecionado === '2023.1' ? 'selected' : '' %>>Período letivo: 2023.1</option>
                            <option value="2022.2" <%= periodoSelecionado === '2022.2' ? 'selected' : '' %>>Período letivo: 2022.2</option>
                            <option value="2022.1" <%= periodoSelecionado === '2022.1' ? 'selected' : '' %>>Período letivo: 2022.1</option>
                            <option value="2021.2" <%= periodoSelecionado === '2021.2' ? 'selected' : '' %>>Período letivo: 2021.2</option>
                            <option value="2021.1" <%= periodoSelecionado === '2021.1' ? 'selected' : '' %>>Período letivo: 2021.1</option>
                            <option value="2020.2" <%= periodoSelecionado === '2020.2' ? 'selected' : '' %>>Período letivo: 2020.2</option>
                            <option value="2020.1" <%= periodoSelecionado === '2020.1' ? 'selected' : '' %>>Período letivo: 2020.1</option>
                        </select>
                        <span class="icon-mask icon-chevron-down"></span>
                    </div>
                </div>

                <div class="resumo-grid">
                    <div class="resumo-item">
                        <span id="lblTccs" class="resumo-label">TCCs em andamento</span>
                        <span id="valTccsAndamento" class="resumo-valor">26</span>
                    </div>
                    <div class="resumo-item">
                        <span id="lblAptos" class="resumo-label">Aptos para banca</span>
                        <span id="valAptosBanca" class="resumo-valor">8</span>
                    </div>
                    <div class="resumo-item">
                        <span id="lblBancas" class="resumo-label">Bancas agendadas</span>
                        <span id="valBancasAgendadas" class="resumo-valor">3</span>
                    </div>
                    <div class="resumo-item">
                        <span id="lblConcluidos" class="resumo-label">Concluídos</span>
                        <span id="valConcluidos" class="resumo-valor">15</span>
                    </div>
                </div>

                <button id="btnAcaoRelatorio" class="btn-relatorio" onclick="verRelatorioCompleto()">
                    Ver relatório completo
                </button>
            </div>

            <section class="secao-atalhos">
                <h3 class="secao-titulo">Atalhos rápidos</h3>
                <div class="atalhos-grid">
                    <div id="atalhoAluno" class="card-atalho verde" onclick="navegarAtalho('/cadastrar-aluno?perfil=<%= perfilAtual %>')">
                        <div class="atalho-icone-wrapper">
                            <span class="icon-mask icon-studant"></span>
                        </div>
                        <div class="atalho-info">
                            <span class="atalho-nome">Cadastrar alunos</span>
                            <span id="valAtalhoAlunos" class="atalho-valor">26</span>
                        </div>
                    </div>

                    <div id="atalhoProfessor" class="card-atalho amarelo" onclick="navegarAtalho('/cadastrar-professor?perfil=<%= perfilAtual %>')">
                        <div class="atalho-icone-wrapper">
                            <span class="icon-mask icon-professor"></span>
                        </div>
                        <div class="atalho-info">
                            <span class="atalho-nome">Cadastrar professores</span>
                            <span id="valAtalhoProfessores" class="atalho-valor">11</span>
                        </div>
                    </div>

                    <div id="atalhoTcc" class="card-atalho azul" onclick="navegarAtalho('/cadastrar-tcc?perfil=<%= perfilAtual %>')">
                        <div class="atalho-icone-wrapper">
                            <span class="icon-mask icon-files"></span>
                        </div>
                        <div class="atalho-info">
                            <span class="atalho-nome">Cadastrar TCC</span>
                            <span id="valAtalhoTccs" class="atalho-valor">26</span>
                        </div>
                    </div>

                    <div id="atalhoBanca" class="card-atalho vermelho" onclick="navegarAtalho('/agendar-banca?perfil=<%= perfilAtual %>')">
                        <div class="atalho-icone-wrapper">
                            <span class="icon-mask icon-calendar"></span>
                        </div>
                        <div class="atalho-info">
                            <span class="atalho-nome">Agendar bancas</span>
                            <span id="valAtalhoBancas" class="atalho-valor">3</span>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <nav id="BottomNav">
            <a href="/dashboard?perfil=<%= perfilAtual %>" class="nav-btn <%= (paginaAtual === 'inicio' || paginaAtual === 'dashboard' || paginaAtual === '/dashboard' || !paginaAtual) ? 'ativo active' : '' %>">
                <span class="icon-mask icon-home"></span>
                <span>Início</span>
            </a>
            <a href="/alunos?perfil=<%= perfilAtual %>" class="nav-btn <%= (paginaAtual === 'alunos' || paginaAtual === '/alunos') ? 'ativo active' : '' %>">
                <span class="icon-mask icon-studant"></span>
                <span>Alunos</span>
            </a>
            <a href="/professores?perfil=<%= perfilAtual %>" class="nav-btn <%= (paginaAtual === 'professores' || paginaAtual === '/professores') ? 'ativo active' : '' %>">
                <span class="icon-mask icon-professor"></span>
                <span>Professores</span>
            </a>
            <a href="/acervo?perfil=<%= perfilAtual %>" class="nav-btn <%= (paginaAtual === 'acervo' || paginaAtual === '/acervo') ? 'ativo active' : '' %>">
                <span class="icon-mask icon-acervo"></span>
                <span>Acervo</span>
            </a>
            <button id="btnAbrirMais" type="button" class="nav-btn">
                <span class="icon-mask icon-more"></span>
                <span>Mais</span>
            </button>
        </nav>
    </div>

    <script src="/JS/Resumo.js"></script>
    <script src="/JS/BottomSheet.js"></script>
    <script>
        let periodoFechadoAtual = false;

        function verRelatorioCompleto() {
            window.location.href = '/resumo?perfil=<%= perfilAtual %>';
        }

        function verificarSeFechado(val) {
            if (!val) return false;
            const partes = val.split('.');
            const ano = parseInt(partes[0], 10);
            const semestre = parseInt(partes[1], 10);
            return (ano < 2026) || (ano === 2026 && semestre < 1);
        }

        function atualizarEstadoInterface(val) {
            periodoFechadoAtual = verificarSeFechado(val);
            
            const badgeStatus = document.getElementById('badgeStatusPeriodo');
            const atalhos = document.querySelectorAll('.card-atalho');

            if (periodoFechadoAtual) {
                if (badgeStatus) badgeStatus.classList.remove('oculto');

                atalhos.forEach(el => {
                    el.style.opacity = '0.5';
                    el.style.cursor = 'not-allowed';
                    el.style.pointerEvents = 'none';
                });
            } else {
                if (badgeStatus) badgeStatus.classList.add('oculto');

                atalhos.forEach(el => {
                    el.style.opacity = '1';
                    el.style.cursor = 'pointer';
                    el.style.pointerEvents = 'auto';
                });
            }

            if (typeof atualizarPeriodo === 'function') {
                atualizarPeriodo(val);
            }
        }

        function navegarAtalho(url) {
            if (!periodoFechadoAtual) {
                window.location.href = url;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const select = document.getElementById('periodoLetivo');
            if (select) {
                atualizarEstadoInterface(select.value);
            }
        });
    </script>
</body>
</html>