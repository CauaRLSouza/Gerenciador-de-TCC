<%
    const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'Secretariado';
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Professor</title>
    <link rel="stylesheet" href="/cssSecretaria/CadastrarProfessor.css">
    <script>
        (function() {
            const tema = localStorage.getItem("tema_app") || "sistema";
            if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>

    <div id="TelaCadastrarProfessor">
        <header id="Header">
            <a href="/professores?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Voltar">
                <span class="icon-mask icon-arrow-left"></span>
            </a>
            <h1 id="TituloPagina">Cadastrar professor</h1>
            <a href="/notificacoes?perfil=<%= perfilAtual %>" class="icon-btn icon-notif-wrapper" aria-label="Notificações">
                <span class="icon-mask icon-notification"></span>
            </a>
        </header>

        <main id="CorpoScroll">
            <form action="/professores/cadastrar" method="POST" id="formCadastrarProfessor" class="card-formulario">
                
                <div class="cabecalho-secao">
                    <div class="icone-secao">
                        <span class="icon-mask icon-teacher"></span>
                    </div>
                    <div class="texto-secao">
                        <h2>Dados do professor</h2>
                        <p>Preencha as informações do professor</p>
                    </div>
                </div>

                <div class="campo-grupo">
                    <label for="nomeCompleto">Nome completo <span class="obrigatorio">*</span></label>
                    <input type="text" id="nomeCompleto" name="nomeCompleto" placeholder="Digite o nome completo" required>
                </div>

                <div class="linha-dupla">
                    <div class="campo-grupo">
                        <label for="siape">SIAPE / Registro <span class="obrigatorio">*</span></label>
                        <input type="text" id="siape" name="siape" placeholder="Digite o SIAPE" required>
                    </div>

                    <div class="campo-grupo">
                        <label for="telefone">Telefone</label>
                        <input type="tel" id="telefone" name="telefone" placeholder="(xx) xxxxx-xxxx">
                    </div>
                </div>

                <div class="linha-dupla">
                    <div class="campo-grupo">
                        <label for="dataNascimento">Data de nascimento</label>
                        <div class="wrapper-input-icone">
                            <input type="date" id="dataNascimento" name="dataNascimento">
                            <span class="icon-mask icon-calendar"></span>
                        </div>
                    </div>

                    <div class="campo-grupo">
                        <label for="titulacao">Titulação máxima <span class="obrigatorio">*</span></label>
                        <div class="wrapper-select">
                            <select id="titulacao" name="titulacao" required>
                                <option value="" disabled selected hidden>Selecione a titulação</option>
                                <option value="Graduação">Graduação</option>
                                <option value="Especialização">Especialização</option>
                                <option value="Mestrado">Mestrado</option>
                                <option value="Doutorado">Doutorado</option>
                            </select>
                            <span class="icon-mask icon-chevron-down"></span>
                        </div>
                    </div>
                </div>

                <div class="subtitulo-secao">
                    <h3>Acesso ao sistema</h3>
                </div>

                <div class="campo-grupo">
                    <label for="emailAcesso">E-mail de acesso <span class="obrigatorio">*</span></label>
                    <input type="email" id="emailAcesso" name="emailAcesso" placeholder="Digite o e-mail institucional" required>
                </div>

                <div class="campo-grupo">
                    <label for="senhaProvisoria">Senha provisória <span class="obrigatorio">*</span></label>
                    <div class="wrapper-input-icone">
                        <input type="password" id="senhaProvisoria" name="senhaProvisoria" placeholder="Digite a senha" required>
                        <button type="button" class="btn-toggle-senha" aria-label="Mostrar senha">
                            <span class="icon-mask icon-eye"></span>
                        </button>
                    </div>
                </div>

                <div class="campo-grupo">
                    <label for="confirmarSenha">Confirmar senha <span class="obrigatorio">*</span></label>
                    <div class="wrapper-input-icone">
                        <input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Confirme a senha" required>
                        <button type="button" class="btn-toggle-senha" aria-label="Mostrar senha">
                            <span class="icon-mask icon-eye"></span>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submeter">
                    <span class="icon-mask icon-save"></span>
                    <span>Cadastrar professor</span>
                </button>

            </form>
        </main>
    </div>

    <script>
        document.querySelectorAll('.btn-toggle-senha').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.previousElementSibling;
                const icon = this.querySelector('.icon-mask');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('icon-eye');
                    icon.classList.add('icon-eye-off');
                } else {
                    input.type = 'password';
                    icon.classList.remove('icon-eye-off');
                    icon.classList.add('icon-eye');
                }
            });
        });
    </script>
</body>
</html>