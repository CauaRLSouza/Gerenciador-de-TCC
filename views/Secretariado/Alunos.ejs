        { id: '11', nome: 'Gabriel Santos', curso: 'Licenciatura em Ciências da Computação', semestre: '2024.2', dataEgresso: '2028-07-30', status: 'ativo' },
        { id: '12', nome: 'Heitor Martins', curso: 'Licenciatura em Ciências Agrárias', semestre: '2025.1', dataEgresso: '2029-02-15', status: 'ativo' },
        { id: '13', nome: 'Isabela Ribeiro', curso: 'Licenciatura em Química', semestre: '2021.1', dataEgresso: '2025-07-10', status: 'inativo' },
