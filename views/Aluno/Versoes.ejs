<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Versões</title>
    <link rel="stylesheet" href="/css/versoes.css">
</head>
<body>

    <div id="TelaVersoes">
        <div id="ScrollView">
            <div id="ContainerVersoes">
                
                <!-- Header -->
                <header id="HeaderVersoes">
                     <a href="/configuracoes" id="BtnConfiguracoes" class="icon-btn">
                <span class="icon-mask icon-settings"></span>
                     </a>
                    <h1 id="TituloPagina">Versões</h1>
                    <div class="header-spacer"></div>
                </header>

                <!-- Botão Enviar Nova Versão -->
                <button id="BtnEnviarVersao" type="button">
                    <span class="icon-mask icon-plus"></span>
                    <span>Enviar nova versão</span>
                </button>

                <!-- Filtro Ordenação -->
                <div id="FiltroOrdenacao">
                    <label for="SelectOrdenacao">Ordenar por:</label>
                    <select id="SelectOrdenacao">
                        <option value="recentes">Mais recente</option>
                        <option value="antigas">Mais antiga</option>
                        <option value="alfabetica">Ordem alfabética</option>
                    </select>
                </div>

                <!-- Lista de Versões -->
                <div id="ListaVersoes">

                    <!-- Card Versão 3 -->
                    <article class="card-versao">
                        <div class="card-versao-header">
                            <h2 class="versao-titulo">Versão 3</h2>
                            <span class="badge badge-aguardando">Aguardando revisão</span>
                        </div>

                        <div class="card-versao-data">
                            <span class="icon-mask icon-calendar-sm"></span>
                            <time>15/08/2026 • 14:30</time>
                        </div>

                        <div class="card-versao-detalhes">
                            <p class="versao-descricao">Correções da metodologia e resultados preliminares</p>
                            <button class="btn-detalhes" type="button" aria-label="Ver detalhes">
                                <span class="icon-mask icon-seta"></span>
                            </button>
                        </div>

                        <div class="card-arquivo">
                            <img src="/Icones/pdf-icon.png" alt="PDF" class="icon-pdf">
                            <div class="arquivo-info">
                                <p class="arquivo-nome">TCC_Versao3.pdf</p>
                                <p class="arquivo-tamanho">2.4 MB</p>
                            </div>
                            <button class="btn-download" type="button" aria-label="Baixar arquivo">
                                <span class="icon-mask icon-download"></span>
                            </button>
                        </div>
                    </article>

                    <!-- Card Versão 2 -->
                    <article class="card-versao">
                        <div class="card-versao-header">
                            <h2 class="versao-titulo">Versão 2</h2>
                            <span class="badge badge-revisada">Revisada</span>
                        </div>

                        <div class="card-versao-data">
                            <span class="icon-mask icon-calendar-sm"></span>
                            <time>05/08/2026 • 16:45</time>
                        </div>

                        <div class="card-versao-detalhes">
                            <p class="versao-descricao">Adição do referencial teórico e metodologia</p>
                            <button class="btn-detalhes" type="button" aria-label="Ver detalhes">
                                <span class="icon-mask icon-seta"></span>
                            </button>
                        </div>

                        <div class="card-arquivo">
                            <img src="/Icones/pdf-icon.png" alt="PDF" class="icon-pdf">
                            <div class="arquivo-info">
                                <p class="arquivo-nome">TCC_Versao2.pdf</p>
                                <p class="arquivo-tamanho">2.1 MB</p>
                            </div>
                            <button class="btn-download" type="button" aria-label="Baixar arquivo">
                                <span class="icon-mask icon-download"></span>
                            </button>
                        </div>
                    </article>

                    <!-- Card Versão 1 -->
                    <article class="card-versao">
                        <div class="card-versao-header">
                            <h2 class="versao-titulo">Versão 1</h2>
                            <span class="badge badge-aprovada">Aprovada</span>
                        </div>

                        <div class="card-versao-data">
                            <span class="icon-mask icon-calendar-sm"></span>
                            <time>25/07/2026 • 10:15</time>
                        </div>

                        <div class="card-versao-detalhes">
                            <p class="versao-descricao">Proposta inicial do projeto</p>
                            <button class="btn-detalhes" type="button" aria-label="Ver detalhes">
                                <span class="icon-mask icon-seta"></span>
                            </button>
                        </div>

                        <div class="card-arquivo">
                            <img src="/Icones/pdf-icon.png" alt="PDF" class="icon-pdf">
                            <div class="arquivo-info">
                                <p class="arquivo-nome">TCC_Versao1.pdf</p>
                                <p class="arquivo-tamanho">1.8 MB</p>
                            </div>
                            <button class="btn-download" type="button" aria-label="Baixar arquivo">
                                <span class="icon-mask icon-download"></span>
                            </button>
                        </div>
                    </article>

                </div>

            </div>
        </div>

        <!-- Bottom Navigation -->
        <nav id="BottomNav">
            <a href="/dashboard" id="NavHome" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>

            <a href="/meutcc" id="NavTCC" class="nav-btn active">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>

            <a href="/agenda" id="NavAgenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>

            <a href="/acervo" id="BtnAcervo" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>

            <a href="/perfil" id="NavPerfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

</body>
</html>