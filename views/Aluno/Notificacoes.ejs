<!-- views/notificacoes.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notificações - TCC</title>
    <link rel="stylesheet" href="/cssAluno/Notificacoes.css">
     <script>
    (function() {
        const tema = localStorage.getItem("tema_app") || "sistema";
        if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.setAttribute("data-tema", "escuro");
            document.addEventListener("DOMContentLoaded", () => document.body.setAttribute("data-tema", "escuro"));
        }
    })();
    </script>
</head>
<body>

    <div id="TelaNotificacoes">

        <!-- ==========================================================================
           1. HEADER
           ========================================================================== -->
        <header id="HeaderNotificacoes">
              <a href="/configuracoes" id="BtnConfiguracoes" class="icon-btn">
                <span class="icon-mask icon-settings"></span>
              </a>
            <h1 id="TituloPagina">Notificações</h1>
            <a href="/notificacoes" id="HeaderSinoWrapper">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <!-- ==========================================================================
           2. SCROLLVIEW / CONTEÚDO
           ========================================================================== -->
        <main id="ScrollView">
            <div id="ContainerNotificacoes">

                <div id="AcaoMarcarTodas">
                    <button id="BtnMarcarLidas">Marcar todas como lidas</button>
                </div>

                <section class="secao-notificacoes">
                    <h2 class="secao-titulo">Hoje</h2>
                    
                    <div class="lista-itens">
                        <article class="card-notificacao nao-lida">
                            <div class="notificacao-icone bg-roxo">
                                <span class="icon-mask icon-sino"></span>
                            </div>
                            <div class="notificacao-conteudo">
                                <div class="notificacao-top">
                                    <h3 class="notificacao-titulo">Novo comentário na versão 3</h3>
                                    <span class="notificacao-hora">09:20</span>
                                </div>
                                <div class="notificacao-bottom">
                                    <p class="notificacao-texto">Prof. Pedro Santos comentou seu trabalho.</p>
                                    <span class="status-dot"></span>
                                </div>
                            </div>
                        </article>

                        <article class="card-notificacao nao-lida">
                            <div class="notificacao-icone bg-verde">
                                <span class="icon-mask icon-files"></span>
                            </div>
                            <div class="notificacao-conteudo">
                                <div class="notificacao-top">
                                    <h3 class="notificacao-titulo">Versão enviada com sucesso</h3>
                                    <span class="notificacao-hora">14:30</span>
                                </div>
                                <div class="notificacao-bottom">
                                    <p class="notificacao-texto">Sua versão 3 foi enviada para revisão.</p>
                                    <span class="status-dot"></span>
                                </div>
                            </div>
                        </article>

                        <article class="card-notificacao lida">
                            <div class="notificacao-icone bg-azul">
                                <span class="icon-mask icon-calendar"></span>
                            </div>
                            <div class="notificacao-conteudo">
                                <div class="notificacao-top">
                                    <h3 class="notificacao-titulo">Reunião agendada</h3>
                                    <span class="notificacao-hora">08:15</span>
                                </div>
                                <div class="notificacao-bottom">
                                    <p class="notificacao-texto">Reunião marcada para 28/08/2026 às 15:00.</p>
                                    <span class="status-dot"></span>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="secao-notificacoes">
                    <h2 class="secao-titulo">Ontem</h2>

                    <div class="lista-itens">
                        <article class="card-notificacao lida">
                            <div class="notificacao-icone bg-roxo-suave">
                                <span class="icon-mask icon-files"></span>
                            </div>
                            <div class="notificacao-conteudo">
                                <div class="notificacao-top">
                                    <h3 class="notificacao-titulo">Prazo se aproximando</h3>
                                    <span class="notificacao-hora">09:00</span>
                                </div>
                                <div class="notificacao-bottom">
                                    <p class="notificacao-texto">Faltam 7 dias para o prazo de entrega da versão parcial.</p>
                                    <span class="status-dot"></span>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

            </div>
        </main>

        <!-- ==========================================================================
           3. BOTTOM NAVIGATION
           ========================================================================== -->
        <nav id="BottomNav">
            <a href="/dashboard" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>
            <a href="/meu-tcc" class="nav-btn">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>
            <a href="/agenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>
            <a href="/acervo" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>
            <a href="/perfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>

    </div>

</body>
</html>