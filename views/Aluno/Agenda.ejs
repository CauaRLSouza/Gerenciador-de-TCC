<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda</title>
    <link rel="stylesheet" href="/css/agenda.css">
     <script>
    (function() {
        const tema = localStorage.getItem("tema_app") || "sistema";
        if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.setAttribute("data-tema", "escuro");
            document.addEventListener("DOMContentLoaded", () => document.body.setAttribute("data-tema", "escuro"));
        }
    })();
    </script>
</head>
<body>

    <div id="TelaAgenda">
        <!-- Header -->
        <header id="Header">
              <a href="/configuracoes" id="BtnConfiguracoes" class="icon-btn">
                <span class="icon-mask icon-settings"></span>
              </a>
            <h1 id="TituloPagina">Agenda</h1>
            <a href="/notificacoes" id="Espacador" class="icon-btn">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <!-- Hero Card (Próximo compromisso) -->
        <section id="AgendaHeroCard" class="card">
            <span id="AgendaHeroTitulo">Próximo compromisso</span>
            <div id="AgendaHeroLinha">
                <div id="AgendaHeroData">
                    <span id="AgendaHeroMes">AGO</span>
                    <span id="AgendaHeroDia">28</span>
                </div>
                <div id="AgendaHeroInfo">
                    <span id="AgendaHeroContador">EM 2 DIAS</span>
                    <h2 id="AgendaHeroNome">Reunião de Orientação</h2>
                    <span id="AgendaHeroHorario">Quinta-feira • 15:00</span>
                    <span id="AgendaHeroLocal">Sala 204 • Bloco B</span>
                </div>
            </div>
        </section>

        <!-- Calendário Horizontal -->
        <section id="AgendaCalendario">
            <h3 id="AgendaCalendarioTitulo">Agosto 2026</h3>
            <div id="AgendaCalendarioScroll">
                <div id="AgendaCalendarioLinha">
                    <button type="button" name="AgendaDia24" id="AgendaDia24">24</button>
                    <button type="button" name="AgendaDia25" id="AgendaDia25">25</button>
                    <button type="button" name="AgendaDia26" id="AgendaDia26">26</button>
                    <button type="button" name="AgendaDia27" id="AgendaDia27">27</button>
                    <button type="button" name="AgendaDia28" id="AgendaDia28" class="dia-ativo">28</button>
                    <button type="button" name="AgendaDia29" id="AgendaDia29">29</button>
                    <button type="button" name="AgendaDia30" id="AgendaDia30">30</button>
                    <button type="button" name="AgendaDia31" id="AgendaDia31">31</button>
                </div>
            </div>
        </section>

        <!-- Lista de Reuniões -->
        <main id="AgendaScroll">
            <div id="AgendaLista">
                
                <!-- Reunião 01 -->
                <article id="AgendaReuniao01" class="card-reuniao">
                    <div id="AgendaReuniao01Cabecalho" class="reuniao-cabecalho">
                        <div id="AgendaReuniao01Data" class="reuniao-data">
                            <span id="AgendaReuniao01Mes">AGO</span>
                            <span id="AgendaReuniao01Dia">28</span>
                        </div>
                        <div id="AgendaReuniao01Info" class="reuniao-info">
                            <h4 id="AgendaReuniao01Titulo">Reunião de Orientação</h4>
                            <span id="AgendaReuniao01Horario">15:00</span>
                            <span id="AgendaReuniao01Local">Sala 204 • Bloco B</span>
                        </div>
                    </div>
                    <div id="AgendaReuniao01Separador" class="separador"></div>
                    <p id="AgendaReuniao01Pauta">Discussão dos resultados e próximos passos.</p>
                    <span id="AgendaReuniao01Status" class="status-badge status-confirmada">Confirmada</span>
                </article>

                <!-- Reunião 02 -->
                <article id="AgendaReuniao02" class="card-reuniao">
                    <div id="AgendaReuniao02Cabecalho" class="reuniao-cabecalho">
                        <div id="AgendaReuniao02Data" class="reuniao-data">
                            <span id="AgendaReuniao02Mes">SET</span>
                            <span id="AgendaReuniao02Dia">11</span>
                        </div>
                        <div id="AgendaReuniao02Info" class="reuniao-info">
                            <h4 id="AgendaReuniao02Titulo">Reunião de Orientação</h4>
                            <span id="AgendaReuniao02Horario">16:00</span>
                            <span id="AgendaReuniao02Local">Sala 204 • Bloco B</span>
                        </div>
                    </div>
                    <div id="AgendaReuniao02Separador" class="separador"></div>
                    <p id="AgendaReuniao02Pauta">Revisão final antes da entrega para banca.</p>
                    <span id="AgendaReuniao02Status" class="status-badge status-pendente">Pendente</span>
                </article>

            </div>
        </main>

        <!-- Bottom Navigation Fixo -->
        <nav id="BottomNav">
            <a href="/dashboard" id="NavHome" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>

            <a href="/meutcc" id="NavTCC" class="nav-btn">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>

            <a href="/agenda" id="NavAgenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>

            <a href="/acervo" id="NavDocumentos" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>

            <a href="/perfil" id="NavPerfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

    <!-- Script de Ativação Dinâmica da Nav -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pathAtual = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll("#BottomNav .nav-btn");

            navLinks.forEach(link => {
                const href = link.getAttribute("href").toLowerCase();
                
                if (pathAtual === href || (pathAtual === "/" && href === "/dashboard")) {
                    link.classList.add("active");
                }
            });
        });
    </script>

</body>
</html>