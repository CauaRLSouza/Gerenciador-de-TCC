<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil</title>
    <link rel="stylesheet" href="/css/perfil.css">
</head>
<body>

    <div id="TelaPerfil">
        <!-- Header -->
        <header id="Header">
            <a href="/dashboard" id="BtnVoltar" class="icon-btn">
                <span class="icon-mask icon-menu"></span>
            </a>
            <h1 id="TituloPagina">Meu Perfil</h1>
            <a href="/notificacoes" id="BtnNotif" class="icon-btn">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <!-- Conteúdo Rolável -->
        <main id="PerfilScroll">
            <section id="PerfilCard" class="card">
                
                <!-- Cabeçalho do Card (Avatar + Infos Principais) -->
                <div id="PerfilHeaderCard">
                    <div id="AvatarContainer">
                        <div id="AvatarCircle">
                            <span id="AvatarIniciais">A</span>
                        </div>
                        <button id="BtnTrocarFoto" type="button" aria-label="Trocar Foto de Perfil"></button>
                    </div>
                    <h2 id="PerfilNome">Aluno</h2>
                    <span id="PerfilEmail">aluno@email.com</span>
                    <span id="PerfilTelefone">4002-8922</span>
                </div>

                <!-- Divisor -->
                <div id="PerfilDivisor" class="divisor"></div>

                <!-- Lista de Detalhes Acadêmicos -->
                <div id="PerfilDetalhes">
                    <div class="PerfilLinha">
                        <span class="perfil-label">Matrícula</span>
                        <span class="perfil-valor">202620262026</span>
                    </div>
                    <div class="PerfilLinha">
                        <span class="perfil-label">Curso</span>
                        <span class="perfil-valor">Licenciatura em Ciências da Computação</span>
                    </div>
                    <div class="PerfilLinha">
                        <span class="perfil-label">Período</span>
                        <span class="perfil-valor">8° Período</span>
                    </div>
                    <div class="PerfilLinha">
                        <span class="perfil-label">Data de egresso</span>
                        <span class="perfil-valor">17/07/2023</span>
                    </div>
                </div>

            </section>
        </main>

        <!-- Bottom Navigation Fixo -->
        <nav id="BottomNav">
            <a href="/dashboard" id="NavHome" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>

            <a href="/meutcc" id="NavTCC" class="nav-btn">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>

            <a href="/agenda" id="NavAgenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>

            <a href="/acervo" id="BtnAcervo" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>

            <a href="/perfil" id="NavPerfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

    <!-- Script de Ativação Dinâmica da Nav -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pathAtual = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll("#BottomNav .nav-btn");

            navLinks.forEach(link => {
                const href = link.getAttribute("href").toLowerCase();
                if (pathAtual === href || (pathAtual === "/" && href === "/dashboard")) {
                    link.classList.add("active");
                }
            });
        });
    </script>

</body>
</html>