<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu TCC</title>
    <link rel="stylesheet" href="/css/meutcc.css">
</head>
<body>

    <div id="MeuTCC">
        <!-- Header Topo a Topo -->
        <header id="Header">
              <a href="/configuracoes" id="BtnConfiguracoes" class="icon-btn">
                <span class="icon-mask icon-settings"></span>
             </a>
            <h1 id="TituloPagina">Meu TCC</h1>
            <a href="/notificacoes" id="BtnNotificacoes" class="icon-btn">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <!-- Corpo com Scroll -->
        <main id="CorpoScroll">
            
            <!-- Card Título -->
            <section id="CardTitulo" class="card">
                <span id="LabelTituloCard">Título do Trabalho</span>
                <h2 id="NomeTCC">Sistema de Gerenciamento de TCC</h2>
                <div class="card-status">
                    <span id="BadgeStatus" class="badge badge-em-andamento">Em desenvolvimento</span>
                </div>
            </section>

            <!-- Card Descrição -->
            <section id="CardDescricao" class="card">
                <h3 id="TituloDescricao">Descrição</h3>
                <p id="TextoDescricao">
                    O objetivo deste trabalho é desenvolver um sistema para gerenciamento de Trabalhos de Conclusão de Curso, facilitando o acompanhamento entre alunos, orientadores e coordenação.
                </p>
                <a href="/versoes" id="BtnVersoes" class="btn-link">Ver todas as versões</a>
            </section>

            <!-- Lista de Informações -->
            <section id="ListaInformacoes">
                
                <div id="ItemOrientador" class="info-item">
                    <div class="info-icone-bg bg-roxo">
                        <span class="icon-mask icon-orientador"></span>
                    </div>
                    <div class="info-detalhes">
                        <span class="info-label">Orientador</span>
                        <strong class="info-value">Prof. Pedro Santos</strong>
                    </div>
                </div>

                <div id="ItemCoorientador" class="info-item">
                    <div class="info-icone-bg bg-azul">
                        <span class="icon-mask icon-coorientador"></span>
                    </div>
                    <div class="info-detalhes">
                        <span class="info-label">Coorientador</span>
                        <strong class="info-value">Prof. Maria Silva</strong>
                    </div>
                </div>

                <div id="ItemCurso" class="info-item">
                    <div class="info-icone-bg bg-verde">
                        <span class="icon-mask icon-curso"></span>
                    </div>
                    <div class="info-detalhes">
                        <span class="info-label">Curso</span>
                        <strong class="info-value">Licenciatura em Ciências da Computação</strong>
                    </div>
                </div>

                <div id="ItemInicio" class="info-item">
                    <div class="info-icone-bg bg-amarelo">
                        <span class="icon-mask icon-ingresso"></span>
                    </div>
                    <div class="info-detalhes">
                        <span class="info-label">Data de ingresso</span>
                        <strong class="info-value">10/03/2025</strong>
                    </div>
                </div>

            </section>

        </main>

        <!-- Bottom Navigation Fixo -->
        <nav id="BottomNav">
            <a href="/dashboard" id="BtnInicio" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>

            <a href="/meutcc" id="BtnMeuTCC" class="nav-btn">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>

            <a href="/agenda" id="BtnAgenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>

            <a href="/acervo" id="BtnAcervo" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>

            <a href="/perfil" id="BtnPerfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>

    </div>

    <!-- Script para Ativar o Botão Automaticamente pelo URL -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pathAtual = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll("#BottomNav .nav-btn");

            navLinks.forEach(link => {
                const href = link.getAttribute("href").toLowerCase();
                
                if (pathAtual === href || (pathAtual === "/" && href === "/dashboard")) {
                    link.classList.add("active");
                }
            });
        });
    </script>

</body>
</html>