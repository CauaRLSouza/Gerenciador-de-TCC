<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/Dashboard.css">
     <script>
    (function() {
        const tema = localStorage.getItem("tema_app") || "sistema";
        if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.setAttribute("data-tema", "escuro");
            document.addEventListener("DOMContentLoaded", () => document.body.setAttribute("data-tema", "escuro"));
        }
    })();
    </script>
</head>
<body>

    <div id="TelaDashboard">

        <!-- Header fora do ScrollView para encostar nas bordas -->
        <header id="Header">
            <a href="/configuracoes" id="BtnConfiguracoes" class="icon-btn">
                <span class="icon-mask icon-settings"></span>
            </a>
            <h1 id="TituloPagina">Dashboard</h1>
            <a href="/notificacoes" id="BtnNotificacoes" class="icon-btn">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <!-- Área de rolagem apenas com os cards e conteúdo -->
        <div id="ScrollView">
            <div id="Dashboard">

                <section id="Saudacoes">
                    <p id="OlaAluno">Olá, Aluno!</p>
                    <p id="OlaOrientador">Orientador: Prof. Nome</p>
                    <p id="OlaCoorientador">Coorientador: Prof. Nome</p>
                </section>

                <div id="CardTCC" class="card">
                    <div class="HeaderGroup">
                        <img src="/Icones/File-removebg-preview.png" alt="TCC" class="card-icon">
                        <p id="Etapa" class="card-etapa">Etapa: Revisão Bibliográfica</p>
                    </div>
                    <div class="card-center-content">
                        <p id="TituloTCC" class="text-center card-title">Sistema de Gerenciamento de TCC</p>
                        <p id="UltimaAtualizacao" class="text-center card-subtext">Última atualização: 29/07/2026</p>
                    </div>
                </div>

                <div id="CardAgenda" class="card">
                    <div class="HeaderGroup">
                        <img src="/Icones/Calendar-removebg-preview.png" alt="Agenda" class="card-icon">
                        <p id="Prazo" class="card-etapa">Próximo prazo:</p>
                    </div>
                    <div class="card-center-content">
                        <p id="Data" class="text-center card-title">28/08/2026</p>
                        <p id="Evento" class="text-center card-subtext">Reunião com orientador</p>
                    </div>
                </div>

                <div id="CardVersion" class="card">
                    <div class="HeaderGroup">
                        <img src="/Icones/Version-removebg-preview.png" alt="Versão" class="card-icon">
                        <p id="VersaoTXT" class="card-etapa">Versão atual</p>
                    </div>
                    <div class="card-center-content">
                        <p id="VersaoAtual" class="text-center card-title">Versão 4</p>
                        <p id="UltimaAtualizacaoVersion" class="text-center card-subtext">Pendente de revisão</p>
                    </div>
                </div>

                <div id="CardFeedback" class="card">
                    <div class="HeaderGroup">
                        <img src="/Icones/Comment-removebg-preview.png" alt="Feedback" class="card-icon">
                        <p id="Notif" class="card-etapa">Comentários não lidos</p>
                    </div>
                    <div class="card-center-content">
                        <p id="PendenciasAtuais" class="text-center card-title">2 Comentários não lidos</p>
                        <p id="UltimoFeedback" class="text-center card-subtext">Último comentário em: 09/08/2026</p>
                    </div>
                    <button id="BtnSeta" class="btn-arrow-box" type="button">
                        <span class="icon-mask icon-seta"></span>
                    </button>
                </div>

            </div>
        </div>

        <!-- Bottom Navigation -->
        <nav id="BottomNav">
            <a href="/dashboard" id="BtnInicio" class="nav-btn">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>

            <a href="/meutcc" id="BtnMeuTCC" class="nav-btn">
                <span class="icon-mask icon-files"></span>
                <span class="Texto">Meu TCC</span>
            </a>

            <a href="/agenda" id="BtnAgenda" class="nav-btn">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Reuniões</span>
            </a>

            <a href="/acervo" id="BtnAcervo" class="nav-btn">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>

            <a href="/perfil" id="BtnPerfil" class="nav-btn">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pathAtual = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll("#BottomNav .nav-btn");

            navLinks.forEach(link => {
                const href = link.getAttribute("href").toLowerCase();
                
                if (pathAtual === href || (pathAtual === "/" && href === "/dashboard")) {
                    link.classList.add("active");
                }
            });
        });
    </script>

</body>
</html> 