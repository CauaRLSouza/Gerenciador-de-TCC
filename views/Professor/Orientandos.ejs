<%
    const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'professor';
    const paginaAtual = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : 'orientandos';
    
    const listaOrientandos = (typeof orientandos !== 'undefined' && orientandos) ? orientandos : [
        { id: 1, nome: 'João da Silva', iniciais: 'JS', ultimaVersao: '15/08/2025', badgeVersao: 2, status: 'Aguardando revisão', statusCor: 'yellow' },
        { id: 2, nome: 'Maria Santos', iniciais: 'MS', ultimaVersao: '12/08/2025', badgeVersao: 1, status: 'Revisada', statusCor: 'green' },
        { id: 3, nome: 'Carlos Correia', iniciais: 'CC', ultimaVersao: '07/08/2025', badgeVersao: 1, status: 'Revisada', statusCor: 'green' }
    ];
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus Orientandos - Professor</title>
    <link rel="stylesheet" href="/cssProfessor/Orientandos.css">
    <script>
        (function() {
            const tema = localStorage.getItem("tema_app") || "sistema";
            if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>

    <div id="TelaOrientandos">
        <header id="Header">
            <a href="/configuracoes?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Configurações">
                <span class="icon-mask icon-settings"></span>
            </a>
            <h1 id="TituloPagina">Meus Orientandos</h1>
            <a href="/notificacoes?perfil=<%= perfilAtual %>" class="icon-btn" aria-label="Notificações">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <main id="CorpoScroll">
            <div style="display: flex; gap: 10px; align-items: center; margin-top: 4px; margin-bottom: 12px;">
                <div style="flex: 1; position: relative; display: flex; align-items: center;">
                    <span class="icon-mask icon-search" style="position: absolute; left: 14px; width: 18px; height: 18px; background-color: var(--text-2);"></span>
                    <input type="text" id="inputBusca" placeholder="Buscar orientando..." style="width: 100%; padding: 12px 14px 12px 42px; border-radius: 24px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text-1); font-size: 0.875rem; outline: none;">
                </div>
                <button id="btnFiltro" style="background: none; border: none; cursor: pointer; padding: 8px; display: flex; align-items: center; justify-content: center;" aria-label="Filtrar">
                    <span class="icon-mask icon-filter" style="width: 22px; height: 22px; background-color: var(--text-1);"></span>
                </button>
            </div>

            <section id="listaOrientandos" style="display: flex; flex-direction: column; gap: 12px;">
                <% listaOrientandos.forEach(aluno => { %>
                    <a href="/orientando/<%= aluno.id %>?perfil=<%= perfilAtual %>" 
                       class="card-orientando" 
                       data-nome="<%= aluno.nome %>" 
                       data-status="<%= aluno.status %>"
                       style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; text-decoration: none; display: flex; align-items: center; gap: 14px; position: relative;">
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--primary-bg); color: var(--primary); font-weight: 800; font-size: 0.9375rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <%= aluno.iniciais %>
                        </div>
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
                            <span style="font-size: 0.9375rem; font-weight: 700; color: var(--text-1);"><%= aluno.nome %></span>
                            <span style="font-size: 0.75rem; color: var(--text-2);">Última versão: <%= aluno.versaoAtual || (aluno.versoes && aluno.versoes.length > 0 ? aluno.versoes[0].titulo + ' - ' + aluno.versoes[0].data : 'Não informada') %></span>
                            <div style="margin-top: 2px;">
                                <% if (aluno.statusCor === 'yellow') { %>
                                    <span style="background: var(--yellow-bg); color: var(--yellow); padding: 4px 10px; border-radius: 12px; font-size: 0.6875rem; font-weight: 700; display: inline-block;">
                                        <%= aluno.status %>
                                    </span>
                                <% } else if (aluno.statusCor === 'green') { %>
                                    <span style="background: var(--green-bg); color: var(--green); padding: 4px 10px; border-radius: 12px; font-size: 0.6875rem; font-weight: 700; display: inline-block;">
                                        <%= aluno.status %>
                                    </span>
                                <% } else { %>
                                    <span style="background: var(--blue-bg); color: var(--blue); padding: 4px 10px; border-radius: 12px; font-size: 0.6875rem; font-weight: 700; display: inline-block;">
                                        <%= aluno.status %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <% if (aluno.badgeVersao) { %>
                                <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--primary); color: #ffffff; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center;">
                                    <%= aluno.badgeVersao %>
                                </div>
                            <% } %>
                            <span class="icon-mask icon-chevron-right" style="width: 18px; height: 18px; background-color: var(--text-2);"></span>
                        </div>
                    </a>
                <% }); %>
            </section>
        </main>

        <a href="/cadastrar-tcc?perfil=<%= perfilAtual %>" class="btn-fab" aria-label="Cadastrar novo TCC">
            <span class="icon-mask icon-plus"></span>
        </a>

        <nav id="BottomNav">
            <a href="/dashboard?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'dashboard' || paginaAtual === 'inicio' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>
            <a href="/orientandos?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'orientandos' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-group"></span>
                <span class="Texto">Orientandos</span>
            </a>
            <a href="/agenda?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'agenda' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Agenda</span>
            </a>
            <a href="/acervo?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'acervo' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>
            <a href="/perfil?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'perfil' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

    <script src="/js/orientandos.js" defer></script>
</body>
</html>