<%
    const user = (typeof usuario !== 'undefined' && usuario) ? usuario : { nome: 'Prof. Pedro' };
    const res = (typeof resumo !== 'undefined' && resumo) ? resumo : {
        orientandosAtivos: 8,
        versoesAguardando: 5,
        reunioesHoje: 2,
        tccsAptos: 3,
        comentariosNaoLidos: 7
    };
    const listaReunioes = (typeof proximasReunioes !== 'undefined' && proximasReunioes) ? proximasReunioes : [
        { horario: '10:00', titulo: 'Reunião com João da Silva', local: 'Sala 204 - Bloco B' },
        { horario: '14:00', titulo: 'Reunião com Maria Santos', local: 'Online - Google Meet' }
    ];
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Professor</title>
    <link rel="stylesheet" href="/cssProfessor/Dashboard.css">
    <script>
        (function() {
            const temaSalvo = localStorage.getItem("tema_app");
            if (temaSalvo) {
                document.documentElement.setAttribute("data-tema", temaSalvo);
            } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>

    <div id="TelaDashboard">
        <header id="Header">
            <a href="/configuracoes?perfil=<%= perfil %>" class="icon-btn" aria-label="Configurações">
                <span class="icon-mask icon-settings"></span>
            </a>
            <h1 id="TituloPagina">Dashboard</h1>
            <a href="/notificacoes?perfil=<%= perfil %>" class="icon-btn" aria-label="Notificações">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <main id="CorpoScroll">
            <section style="margin-top: 4px;">
                <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-1);">Olá, <%= user.nome %>! 👋</h2>
                <p style="font-size: 0.875rem; color: var(--text-2); margin-top: 2px;">Aqui está o resumo das suas orientações</p>
            </section>

            <a href="/orientandos?perfil=<%= perfil %>" class="card-hero">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <span style="font-size: 0.875rem; opacity: 0.9; font-weight: 500;">Meus orientandos</span>
                        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 4px;">
                            <span style="font-size: 2.25rem; font-weight: 800; line-height: 1;"><%= res.orientandosAtivos %></span>
                            <span style="font-size: 0.875rem; opacity: 0.9;">orientandos ativos</span>
                        </div>
                    </div>
                    <div style="background: rgba(255, 255, 255, 0.2); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span class="icon-mask icon-perfil" style="background-color: #ffffff; width: 24px; height: 24px;"></span>
                    </div>
                </div>
                <div style="background: #ffffff; color: var(--primary); text-align: center; padding: 10px; border-radius: 20px; font-weight: 700; font-size: 0.875rem;">
                    Ver todos
                </div>
            </a>

            <section style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; min-height: 130px;">
                    <div>
                        <span style="font-size: 0.75rem; color: var(--text-2); font-weight: 600; display: block; line-height: 1.2;">Versões</span>
                        <span style="font-size: 0.75rem; color: var(--text-2); display: block; line-height: 1.2;">aguardando revisão</span>
                        <span style="font-size: 1.75rem; font-weight: 800; color: var(--green); margin-top: 6px; display: block;"><%= res.versoesAguardando %></span>
                    </div>
                    <a href="/versoes?perfil=<%= perfil %>" style="background: var(--green-bg); color: var(--green); text-decoration: none; text-align: center; padding: 6px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-top: 8px; display: inline-block; width: fit-content;">
                        Ver versões
                    </a>
                </div>

                <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; min-height: 130px;">
                    <div>
                        <span style="font-size: 0.75rem; color: var(--text-2); font-weight: 600; display: block; line-height: 1.2;">Reuniões hoje</span>
                        <span style="font-size: 1.75rem; font-weight: 800; color: var(--yellow); margin-top: 18px; display: block;"><%= res.reunioesHoje %></span>
                    </div>
                    <a href="/agenda?perfil=<%= perfil %>" style="background: var(--yellow-bg); color: var(--yellow); text-decoration: none; text-align: center; padding: 6px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-top: 8px; display: inline-block; width: fit-content;">
                        Ver agenda
                    </a>
                </div>

                <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; min-height: 130px;">
                    <div>
                        <span style="font-size: 0.75rem; color: var(--text-2); font-weight: 600; display: block; line-height: 1.2;">TCCs aptos para banca</span>
                        <span style="font-size: 1.75rem; font-weight: 800; color: var(--blue); margin-top: 18px; display: block;"><%= res.tccsAptos %></span>
                    </div>
                    <a href="/bancas?perfil=<%= perfil %>" style="background: var(--blue-bg); color: var(--blue); text-decoration: none; text-align: center; padding: 6px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-top: 8px; display: inline-block; width: fit-content;">
                        Ver lista
                    </a>
                </div>

                <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; min-height: 130px;">
                    <div>
                        <span style="font-size: 0.75rem; color: var(--text-2); font-weight: 600; display: block; line-height: 1.2;">Comentários não lidos</span>
                        <span style="font-size: 1.75rem; font-weight: 800; color: var(--primary); margin-top: 18px; display: block;"><%= res.comentariosNaoLidos %></span>
                    </div>
                    <a href="/comentarios?perfil=<%= perfil %>" style="background: var(--primary-bg); color: var(--primary); text-decoration: none; text-align: center; padding: 6px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-top: 8px; display: inline-block; width: fit-content;">
                        Ver comentários
                    </a>
                </div>
            </section>

            <section style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-1);">Próximas reuniões</h3>
                    <a href="/reunioes?perfil=<%= perfil %>" style="font-size: 0.8125rem; font-weight: 700; color: var(--primary); text-decoration: none;">Ver agenda</a>
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <% listaReunioes.forEach(reuniao => { %>
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <span style="font-weight: 800; font-size: 0.875rem; color: var(--text-1); min-width: 45px;"><%= reuniao.horario %></span>
                            <div style="display: flex; flex-direction: column; gap: 2px;">
                                <span style="font-size: 0.8125rem; font-weight: 700; color: var(--text-1);"><%= reuniao.titulo %></span>
                                <span style="font-size: 0.75rem; color: var(--text-2);"><%= reuniao.local %></span>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>
        </main>

        <nav id="BottomNav">
            <a href="/dashboard?perfil=<%= perfil %>" class="nav-btn <%= currentPage === 'dashboard' || currentPage === 'inicio' ? 'active' : '' %>">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>
            <a href="/orientandos?perfil=<%= perfil %>" class="nav-btn <%= currentPage === 'orientandos' ? 'active' : '' %>">
                <span class="icon-mask icon-group"></span>
                <span class="Texto">Orientandos</span>
            </a>
            <a href="/agenda?perfil=<%= perfil %>" class="nav-btn <%= currentPage === 'agenda' ? 'active' : '' %>">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Agenda</span>
            </a>
            <a href="/acervo?perfil=<%= perfil %>" class="nav-btn <%= currentPage === 'acervo' ? 'active' : '' %>">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>
            <a href="/perfil?perfil=<%= perfil %>" class="nav-btn <%= currentPage === 'perfil' ? 'active' : '' %>">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const temaSalvo = localStorage.getItem("tema_app");
            if (temaSalvo) {
                document.documentElement.setAttribute("data-tema", temaSalvo);
                document.body.setAttribute("data-tema", temaSalvo);
            }
        });
    </script>
</body>
</html>