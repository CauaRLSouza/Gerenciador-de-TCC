<%
    const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'professor';
    const paginaAtual = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : 'agenda';
    const listaOrientandos = (typeof orientandos !== 'undefined' && orientandos) ? orientandos : [
        { id: 1, nome: 'João da Silva' },
        { id: 2, nome: 'Maria Santos' },
        { id: 3, nome: 'Carlos Correia' }

    ];
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda - Professor</title>
    <link rel="stylesheet" href="/cssProfessor/agenda.css">
    <link rel="stylesheet" href="/cssProfessor/BoxAgenda.css">
    <script>
    (function() {
        const tema = localStorage.getItem("tema_app") || "sistema";
        if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.setAttribute("data-tema", "escuro");
            document.addEventListener("DOMContentLoaded", () => document.body.setAttribute("data-tema", "escuro"));
        }
    })();
    </script>
</head>
<body>

    <div id="TelaAgenda">
        <header id="Header">
            <a href="/configuracoes?perfil=<%= perfilAtual %>" id="BtnConfiguracoes" class="icon-btn" aria-label="Configurações">
                <span class="icon-mask icon-settings"></span>
            </a>
            <h1 id="TituloPagina">Agenda</h1>
            <a href="/notificacoes?perfil=<%= perfilAtual %>" id="Espacador" class="icon-btn" aria-label="Notificações">
                <span class="icon-mask icon-sino"></span>
            </a>
        </header>

        <section id="AgendaHeroCard" class="card">
            <span id="AgendaHeroTitulo">Próxima orientação</span>
            <div id="AgendaHeroLinha">
                <div id="AgendaHeroData">
                    <span id="AgendaHeroMes">AGO</span>
                    <span id="AgendaHeroDia">28</span>
                </div>
                <div id="AgendaHeroInfo">
                    <span id="AgendaHeroContador">EM 2 DIAS</span>
                    <h2 id="AgendaHeroNome">Reunião de Orientação</h2>
                    <span id="AgendaHeroHorario">Quinta-feira • 15:00</span>
                    <span id="AgendaHeroLocal">Orientando: João da Silva</span>
                </div>
            </div>
        </section>

        <section id="AgendaCalendario">
            <div id="AgendaCalendarioHeader" style="display: flex; align-items: center; justify-content: space-between;">
                <button type="button" id="BtnMesAnterior" class="btn-navegacao" style="background:none; border:none; color:var(--primary); font-size:1.2rem; cursor:pointer; padding: 4px 8px;">◀</button>
                <h3 id="AgendaCalendarioTitulo">Agosto 2026</h3>
                <button type="button" id="BtnMesProximo" class="btn-navegacao" style="background:none; border:none; color:var(--primary); font-size:1.2rem; cursor:pointer; padding: 4px 8px;">▶</button>
            </div>

            <div id="AgendaSemanaContainer" style="display: flex; align-items: center; gap: 4px; margin-top: 8px;">
                <button type="button" id="BtnSemanaAnterior" class="btn-navegacao" style="background:none; border:none; color:var(--primary); font-size:1rem; cursor:pointer; padding: 4px;">◀</button>
                
                <div id="AgendaCalendarioScroll" style="flex: 1; overflow-x: auto; scrollbar-width: none;">
                    <div id="AgendaCalendarioLinha" style="display: flex; gap: 8px;"></div>
                </div>

                <button type="button" id="BtnSemanaProxima" class="btn-navegacao" style="background:none; border:none; color:var(--primary); font-size:1rem; cursor:pointer; padding: 4px;">▶</button>
            </div>
        </section>

        <main id="AgendaScroll">
            <div id="AgendaLista">
                
                <article id="AgendaReuniao00" class="card-reuniao" data-data="2026-08-05">
                    <div id="AgendaReuniao00Cabecalho" class="reuniao-cabecalho">
                        <div id="AgendaReuniao00Data" class="reuniao-data">
                            <span id="AgendaReuniao00Mes">AGO</span>
                            <span id="AgendaReuniao00Dia">05</span>
                        </div>
                        <div id="AgendaReuniao00Info" class="reuniao-info">
                            <h4 id="AgendaReuniao00Titulo">Maria Santos</h4>
                            <span id="AgendaReuniao00Horario">14:00 • Sala 204</span>
                        </div>
                    </div>
                    <div id="AgendaReuniao00Separador" class="separador"></div>
                    <p id="AgendaReuniao00Pauta">Definição do tema do TCC e cronograma inicial.</p>
                    <span id="AgendaReuniao00Status" class="status-badge status-realizada">Realizada</span>
                </article>

                <article id="AgendaReuniao01" class="card-reuniao" data-data="2026-08-28">
                    <div id="AgendaReuniao01Cabecalho" class="reuniao-cabecalho">
                        <div id="AgendaReuniao01Data" class="reuniao-data">
                            <span id="AgendaReuniao01Mes">AGO</span>
                            <span id="AgendaReuniao01Dia">28</span>
                        </div>
                        <div id="AgendaReuniao01Info" class="reuniao-info">
                            <h4 id="AgendaReuniao01Titulo">João da Silva</h4>
                            <span id="AgendaReuniao01Horario">15:00 • Sala Virtual</span>
                        </div>
                    </div>
                    <div id="AgendaReuniao01Separador" class="separador"></div>
                    <p id="AgendaReuniao01Pauta">Reunião de Orientação</p>
                    <span id="AgendaReuniao01Status" class="status-badge status-pendente">Agendada</span>
                </article>

                <article id="AgendaReuniao02" class="card-reuniao" data-data="2026-09-11">
                    <div id="AgendaReuniao02Cabecalho" class="reuniao-cabecalho">
                        <div id="AgendaReuniao02Data" class="reuniao-data">
                            <span id="AgendaReuniao02Mes">SET</span>
                            <span id="AgendaReuniao02Dia">11</span>
                        </div>
                        <div id="AgendaReuniao02Info" class="reuniao-info">
                            <h4 id="AgendaReuniao02Titulo">Maria Santos</h4>
                            <span id="AgendaReuniao02Horario">14:00 • Sala Virtual</span>
                        </div>
                    </div>
                    <div id="AgendaReuniao02Separador" class="separador"></div>
                    <p id="AgendaReuniao02Pauta">Reunião de Orientação</p>
                    <span id="AgendaReuniao02Status" class="status-badge status-pendente">Agendada</span>
                </article>

                <div id="AgendaEmptyState" class="agenda-empty-state" style="display: none; text-align: center; padding: 30px 10px;">
                    <span style="font-size: 2rem; display: block; margin-bottom: 8px;">📅</span>
                    <p style="font-size: 0.875rem; color: var(--text-2); font-weight: 600;">Nenhuma orientação agendada para este dia.</p>
                </div>

            </div>
        </main>

        <button type="button" id="BtnNovaReuniao" class="fab-agendar" aria-label="Nova Reunião">
            <span class="icon-mask icon-plus"></span>
        </button>

        <nav id="BottomNav">
            <a href="/dashboard?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'dashboard' || paginaAtual === 'inicio' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-home"></span>
                <span class="Texto">Início</span>
            </a>
            <a href="/orientandos?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'orientandos' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-group"></span>
                <span class="Texto">Orientandos</span>
            </a>
            <a href="/agenda?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'agenda' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-calendar"></span>
                <span class="Texto">Agenda</span>
            </a>
            <a href="/acervo?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'acervo' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-acervo"></span>
                <span class="Texto">Acervo</span>
            </a>
            <a href="/perfil?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'perfil' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-perfil"></span>
                <span class="Texto">Perfil</span>
            </a>
        </nav>
    </div>

    <div id="modalAgendarReuniao" class="modal-overlay" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <div>
                    <h2>Agendar reunião</h2>
                    <p>Preencha os dados para agendar a reunião com seu orientando.</p>
                </div>
                <button type="button" id="btnFecharModal" class="btn-close">&times;</button>
            </div>

            <form id="formAgendarReuniao" action="/agendar-reuniao" method="POST">
                <input type="hidden" name="perfil" value="<%= perfilAtual %>">

                <div class="form-group">
                    <label for="orientandoId">Orientando</label>
                    <select id="orientandoId" name="orientandoId" required>
                        <option value="" disabled selected>Selecione o orientando</option>
                        <% listaOrientandos.forEach(aluno => { %>
                            <option value="<%= aluno.id %>"><%= aluno.nome %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="dataReuniao">Data</label>
                        <input type="date" id="dataReuniao" name="data" required>
                    </div>
                    <div class="form-group">
                        <label for="horaReuniao">Horário</label>
                        <input type="time" id="horaReuniao" name="hora" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Modalidade</label>
                    <div class="toggle-modalidade">
                        <button type="button" id="btnModalidadePresencial" class="btn-modalidade active">Presencial</button>
                        <button type="button" id="btnModalidadeOnline" class="btn-modalidade">Online</button>
                    </div>
                    <input type="hidden" id="inputModalidade" name="modalidade" value="presencial">
                </div>

                <div class="form-group" id="campoPresencial">
                    <label for="localSala">Local</label>
                    <input type="text" id="localSala" name="local" placeholder="Ex: Sala 204 - Bloco B">
                </div>

                <div class="form-group" id="campoOnline" style="display: none;">
                    <label for="linkReuniao">Link da Reunião</label>
                    <input type="url" id="linkReuniao" name="link" placeholder="https://meet.google.com/abc-defg-hij">
                </div>

                <div class="form-group">
                    <label for="pautaReuniao">Pauta da reunião</label>
                    <textarea id="pautaReuniao" name="pauta" rows="3" maxlength="300" placeholder="Discussão dos resultados e próximos passos."></textarea>
                </div>

                <div class="modal-actions">
                    <button type="button" id="btnCancelarAgendamento" class="btn-secundario">Cancelar</button>
                    <button type="submit" class="btn-primario">Agendar reunião</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/BoxAgenda.js"></script>
</body>
</html>