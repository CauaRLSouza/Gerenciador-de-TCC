<%
    const perfilAtual = (typeof perfil !== 'undefined' && perfil) ? perfil : 'professor';
    const paginaAtual = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : 'dashboard';
    
    const listaBancas = (typeof bancas !== 'undefined' && bancas) ? bancas : [
        { 
            id: 1, 
            nome: 'João da Silva', 
            iniciais: 'JS', 
            tema: 'Sistema de Gerenciamento de TCC', 
            statusVersao: 'Todas as versões aprovadas • Pendências resolvidas • Orientador aprovou', 
            dataBanca: '15/09/2026',
            statusTipo: 'apto' 
        },
        { 
            id: 2, 
            nome: 'Maria Santos', 
            iniciais: 'MS', 
            tema: 'Aplicativo Educacional', 
            statusVersao: 'Em desenvolvimento • Versão final pendente', 
            dataBanca: '18/09/2026',
            statusTipo: 'pendente' 
        },
        { 
            id: 3, 
            nome: 'Carlos Correia', 
            iniciais: 'CC', 
            tema: 'Inteligência Artificial na Educação', 
            statusVersao: 'Em desenvolvimento • Versão final pendente', 
            dataBanca: '20/09/2026 às 14:00',
            statusTipo: 'pendente' 
        }
    ];
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>bancas</title>
    <link rel="stylesheet" href="/cssProfessor/bancas.css">
    <script>
        (function() {
            const tema = localStorage.getItem("tema_app") || "sistema";
            if (tema === "escuro" || (tema === "sistema" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                document.documentElement.setAttribute("data-tema", "escuro");
            }
        })();
    </script>
</head>
<body>

    <div id="TelaDashboard">
        <header id="Header">
            <a href="javascript:history.back()" class="icon-btn" aria-label="Voltar">
                <span class="icon-mask icon-arrow-left"></span>
            </a>
            <h1 id="TituloPagina">TCCs aptos para banca</h1>
            <div class="header-spacer"></div>
        </header>

        <main id="CorpoScroll">
            <div class="card-hero info-banner">
                <div class="banner-content">
                    <p>Estes TCCs estão prontos para a banca. Revise e libere para que a secretaria prossiga com os trâmites.</p>
                </div>
            </div>

            <section class="lista-versoes">
                <% listaBancas.forEach(item => { %>
                    <div class="card-versao-item <%= item.statusTipo === 'apto' ? 'apto' : 'pendente' %>">
                        <div class="card-versao-top">
                            <div class="aluno-header">
                                <div class="avatar-aluno">
                                    <%= item.iniciais %>
                                </div>
                                <div class="info-aluno-header">
                                    <span class="nome-aluno"><%= item.nome %></span>
                                    <span class="titulo-tcc-aluno"><%= item.tema %></span>
                                </div>
                            </div>
                            
                            <div class="detalhes-status">
                                <% if(item.statusTipo === 'apto') { %>
                                    <div class="status-linha"><span class="icon-check">✓</span> Todas as versões aprovadas</div>
                                    <div class="status-linha"><span class="icon-check">✓</span> Pendências resolvidas</div>
                                    <div class="status-linha"><span class="icon-check">✓</span> Orientador aprovou</div>
                                    <div class="data-banca-info">
                                    </div>
                                    <button class="btn-liberar ativo-btn" onclick="liberarBanca('<%= item.nome %>')">
                                        <span class="icon-mask icon-check-circle" style="width: 16px; height: 16px; background-color: #ffffff;"></span>
                                        Liberar para banca
                                    </button>
                                <% } else { %>
                                    <div class="status-linha cinza"><span class="icon-dot"></span> <%= item.statusVersao %></div>
                                    <div class="data-banca-info">
                                        <span class="icon-mask icon-calendar" style="width: 16px; height: 16px;"></span>
                                        <span>Data prevista para banca: <%= item.dataBanca %></span>
                                    </div>
                                    <button class="btn-liberar inativo-btn" disabled>
                                        Liberar para banca
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </section>
        </main>

        <nav id="BottomNav">
            <a href="/dashboard?perfil=<%= perfilAtual %>" class="nav-btn ativo active">
                <span class="icon-mask icon-home"></span>
                <span>Início</span>
            </a>
            <a href="/orientandos?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'orientandos' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-group"></span>
                <span>Orientandos</span>
            </a>
            <a href="/agenda?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'agenda' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-calendar"></span>
                <span>Agenda</span>
            </a>
            <a href="/acervo?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'acervo' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-acervo"></span>
                <span>Acervo</span>
            </a>
            <a href="/perfil?perfil=<%= perfilAtual %>" class="nav-btn <%= paginaAtual === 'perfil' ? 'ativo active' : '' %>">
                <span class="icon-mask icon-perfil"></span>
                <span>Perfil</span>
            </a>
        </nav>
    </div>

    <script>
        function liberarBanca(nome) {
            alert('Liberando TCC para a banca: ' + nome);
        }
    </script>
</body>
</html>