<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orienta TCC - Login</title>
    <link rel="stylesheet" href="css/Login.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <main class="login-container">
        <div class="logo-box">
            <div class="logo-icon">
                <img src="Icones/LogoTCC-removebg-preview.png" alt="Logo Orienta TCC" class="logo-img">
            </div>
            <h1 class="app-title">Orienta<br>TCC</h1>
        </div>

        <form class="login-form" action="/dashboard" method="GET">

            <div class="input-group">
                <i data-lucide="user" class="input-icon"></i>
                <input type="text" placeholder="Digite seu usuário" required>
            </div>

            <div class="input-group">
                <i data-lucide="lock" class="input-icon"></i>
                <input type="password" id="inputSenha" placeholder="Digite sua senha" required>
                <span id="btnToggleEye" style="cursor: pointer; display: inline-flex; align-items: center;">
                    <i data-lucide="eye" class="toggle-eye"></i>
                </span>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox">
                    <span>Lembrar de mim</span>
                </label>
                <a href="#" class="forgot-pass">Esqueci minha senha</a>
            </div>

            <button type="submit" class="btn-entrar">Entrar</button>

        </form>

    </main>

    <script>
        lucide.createIcons();

        document.addEventListener("DOMContentLoaded", () => {
            const inputSenha = document.getElementById("inputSenha");
            const btnToggleEye = document.getElementById("btnToggleEye");

            if (btnToggleEye && inputSenha) {
                btnToggleEye.addEventListener("click", () => {
                    const isPassword = inputSenha.getAttribute("type") === "password";
                    
                    inputSenha.setAttribute("type", isPassword ? "text" : "password");
                    
                    const iconName = isPassword ? "eye-off" : "eye";
                    btnToggleEye.innerHTML = `<i data-lucide="${iconName}" class="toggle-eye"></i>`;
                    
                    lucide.createIcons();
                });
            }
        });
    </script>
</body>
</html>